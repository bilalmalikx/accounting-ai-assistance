# Application
APP_NAME=Accounting AI Assistant
APP_VERSION=1.0.0
DEBUG=False
SECRET_KEY=change-this-to-random-secret-key-in-production
ENVIRONMENT=production

# Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
RELOAD=False
CORS_ORIGINS=["http://localhost:4200", "http://localhost:3000", "http://localhost:8000"]

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120

# Vector Store
CHROMA_PERSIST_DIR=./data/chromadb
CHROMA_COLLECTION_NAME=accounting_docs
CHROMA_DISTANCE_METHOD=cosine

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=[".pdf", ".txt", ".csv", ".xlsx"]
UPLOAD_DIR=./data/uploads
TEMP_DIR=./data/temp

# Security
API_KEY_ENABLED=False
API_KEY=
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
MAX_REQUESTS_PER_IP_PER_MINUTE=60

# Guardrails
ENABLE_INPUT_GUARD=True
ENABLE_OUTPUT_GUARD=True
ENABLE_PII_DETECTION=True
ENABLE_PROMPT_INJECTION_DETECTION=True
ENABLE_ACCOUNTING_RULES=True
INPUT_GUARD_THRESHOLD=0.6
OUTPUT_GUARD_THRESHOLD=0.7

# Logging
LOG_LEVEL=INFO
LOG_FILE=./data/logs/app.log
LOG_FORMAT=json
AUDIT_DB_PATH=./data/audit.db
AUDIT_ENABLED=True

# RAG
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.7
RETRIEVAL_STRATEGY=mmr

# Performance
CACHE_ENABLED=True
CACHE_TTL=3600
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT=30

# Monitoring
METRICS_ENABLED=True
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30