# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# Local Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# PDF Processing
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Paths
VECTOR_STORE_PATH=data/vector_store
UPLOAD_DIR=data/uploads

# Retrieval
TOP_K_RESULTS=3